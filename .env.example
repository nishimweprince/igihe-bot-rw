# Local dev defaults — copy to .env (never commit .env)
DATABASE_URL=sqlite:///data/assistant.db
RAW_STORAGE_ROOT=data/raw
WORDPRESS_BASE_URL=https://old.igihe.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Local MLX checkpoint (takes precedence over OLLAMA_MODEL when set).
# Build it with: scripts/convert_alta_to_hf.py + mlx_lm.convert (see docs).
MLX_MODEL_PATH=
# OpenAI platform (takes precedence over local models when BOTH are set;
# billed per request, RAG evidence only — never the full corpus).
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=fake-hash-v1
EMBEDDING_MODEL_REVISION=v1
RERANKER_MODEL=
MAX_QUERY_CHARS=500
MAX_CONTEXT_TOKENS=3000
MAX_OUTPUT_TOKENS=400
MAX_CONCURRENT_GENERATIONS=4
INGEST_CONCURRENCY=2
LOG_CONTENT=false
BACKEND=fixture
RETRIEVAL_CANDIDATES=hybrid
