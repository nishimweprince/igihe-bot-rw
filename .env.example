# Local dev defaults — copy to .env (never commit .env)
# Start with: uv run --env-file .env uvicorn apps.api.main:app --port 8000

# -- generation ----------------------------------------------------------------
# Explicit choice, no implicit precedence: fake | mlx | openai | ollama
GENERATOR=mlx
MLX_MODEL_PATH=models/gemma-4-e2b-it-mlx
MLX_TEMPERATURE=0.4
# OpenAI is an explicit opt-in (GENERATOR=openai); a set key alone does nothing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Load weights + one warm-up generation at startup (first MLX call is ~15-30 s otherwise).
WARMUP=true
MAX_OUTPUT_TOKENS=200
# MLX is single-stream; keep at 1 for mlx, raise for openai/ollama.
MAX_CONCURRENT_GENERATIONS=1
# Buffered second attempt with a citation nudge when validation fails (off: refuse).
VALIDATION_RETRY=false
HISTORY_TURNS=6

# -- index / retrieval ---------------------------------------------------------
# Persistent trigram index built by scripts/build_index.py. Empty = in-memory
# index from SAMPLE_DIR (page-*.json) or the test fixtures.
INDEX_PATH=data/index/full.sqlite
SAMPLE_DIR=
SQLITE_CACHE_MB=256
CANDIDATES_N=200
# Refuse when the evidence set covers less than this share of the question's terms.
MIN_COVERAGE=0.5
# Recency prior: score *= 1 + weight * 0.5 ** (age_days / half_life). With a
# recency cue in the question, weight=1.0, half-life 30 d and a hard window.
RECENCY_WEIGHT=0.3
RECENCY_HALF_LIFE_DAYS=365
RECENCY_WINDOW_DAYS=180
# Optional neural reranker (needs `uv sync --extra rerank`); empty = off.
RERANKER_MODEL=
MAX_EVIDENCE_SOURCES=4
MAX_EVIDENCE_CHARS=1000

# -- API -----------------------------------------------------------------------
MAX_QUERY_CHARS=500
LOG_CONTENT=false

# -- ingestion -----------------------------------------------------------------
RAW_STORAGE_ROOT=data/raw
WORDPRESS_BASE_URL=https://old.igihe.com
INGEST_CONCURRENCY=2
