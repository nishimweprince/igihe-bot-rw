FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "pydantic>=2.7" \
    "uvicorn>=0.30" \
    "httpx>=0.27" \
    "beautifulsoup4>=4.12" \
    "lxml>=5.2"

COPY src/ ./src/
COPY apps/api/ ./apps/api/

EXPOSE 8000

# Linux hosts have no MLX: mount the index and use GENERATOR=openai or
# GENERATOR=ollama (Ollama reachable at host localhost:11434 with --network
# host). Example:
#   docker run --network host -v $PWD/data/index:/app/data/index \
#     -e INDEX_PATH=data/index/full.sqlite -e GENERATOR=ollama -e OLLAMA_MODEL=... api
CMD ["uvicorn", "apps.api.main:app", "--host", "127.0.0.1", "--port", "8000"]
