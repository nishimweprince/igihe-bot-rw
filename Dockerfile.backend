FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.115" \
    "pydantic>=2.7" \
    "uvicorn>=0.30" \
    "httpx>=0.27" \
    "beautifulsoup4>=4.12" \
    "lxml>=5.2"

COPY src/ ./src/
COPY apps/api/ ./apps/api/

EXPOSE 8000

# With --network host, bind loopback only: nginx proxies 127.0.0.1:8000
# and the container reaches Ollama at host localhost:11434.
CMD ["uvicorn", "apps.api.main:app", "--host", "127.0.0.1", "--port", "8000"]
